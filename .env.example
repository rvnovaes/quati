# Copie para .env e ajuste. Todas as variáveis são lidas pelo docker compose e pelo Django.

ENV=development
DEBUG=true
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Hosts / URLs
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080
PROJECT_LINK=http://localhost:8000
WORKFLOW_EMAIL=http://localhost:8000
NGINX_SERVER_NAME=localhost

# Banco de dados
DB_NAME=ezl
DB_USER=ezl
DB_PASSWORD=ezl
DB_HOST=db
DB_PORT=5432

# Redis / RabbitMQ
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=amqp://guest:guest@queues:5672//
FLOWER_BASIC_AUTH=ezl:flower

# E-mail
# Em desenvolvimento aponte para o Mailpit (serviço "mail"); em produção para o serviço "postfix".
EMAIL_HOST=mail
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Easy Lawyer <contato@ezlawyer.com.br>
# Se definido, redireciona TODOS os e-mails para este endereço (homologação)
DEFAULT_TO_EMAIL=

# Postfix (produção)
POSTFIX_HOSTNAME=mail.ezlawyer.com.br
POSTFIX_ALLOWED_SENDER_DOMAINS=ezlawyer.com.br
# Opcional: relay externo, ex. [smtp.provedor.com]:587
POSTFIX_RELAYHOST=
POSTFIX_RELAYHOST_USERNAME=
POSTFIX_RELAYHOST_PASSWORD=
